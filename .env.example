# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

# Chave secreta do Django. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

# Só use True no seu computador. Em produção, deixe False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# WhatsApp Cloud API (Meta). Valores em developers.facebook.com > seu app > WhatsApp.
# ID do número que envia/recebe (API Setup > Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=
# Token de acesso. O temporário vence em ~24h; em produção use token de usuário do sistema.
WHATSAPP_ACCESS_TOKEN=
# Chave secreta do app (Configurações do app > Básico). Usada para conferir a assinatura
# de cada mensagem recebida e ter certeza de que veio da Meta.
WHATSAPP_APP_SECRET=
# Texto que você inventa e cadastra no webhook da Meta. Gere um aleatório.
WHATSAPP_VERIFY_TOKEN=

# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://agent_financial:troque-a-senha@localhost:5432/agent_financial
